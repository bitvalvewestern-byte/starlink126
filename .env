# ---------------------------------------------------------------
# Copy this file to ".env" and fill in your real values.
# .env must NEVER be committed to git.
# ---------------------------------------------------------------

# PayHero dashboard -> API Keys
PAYHERO_API_USERNAME=your_payhero_api_username
PAYHERO_API_PASSWORD=your_payhero_api_password

# PayHero channel ID (the Till/Paybill you registered on PayHero)
PAYHERO_CHANNEL_ID=1234

# Optional. PayHero base URL (only change this for testing)
PAYHERO_BASE_URL=https://backend.payhero.co.ke/api/v2

# Optional but recommended on a live server: the exact public URL PayHero
# should POST the payment result to. Must be publicly reachable HTTPS.
# If left blank it is auto-built from the incoming request host.
PAYHERO_CALLBACK_URL=https://yourdomain.com/api/payhero-callback

# Port the Express server listens on
PORT=3000
